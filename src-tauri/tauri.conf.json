{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KYN",
  "version": "0.2.0",
  "identifier": "com.kyn.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KYN",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Security toolkit for your own devices and network",
    "copyright": "Personal project",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0RjI3RkNDMzhCMkVCQzAKUldUQTY3STR6SC95NUZ2dW1zeld0K2RWVm9USXJmbFl6UjIrNGxXanVudDhrcDVtWFpYbEhtQ3oK",
      "endpoints": [
        "https://github.com/tormal3vi/KYN/releases/latest/download/latest.json"
      ]
    }
  }
}
